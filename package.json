    "test:browser": "node scripts/browser-runner.mjs",
    "test:browser:smoke": "node scripts/browser-runner.mjs --smoke",
    "test:browser:offline": "node scripts/browser-runner.mjs --offline",
    "sql:generate": "node scripts/sql-bundles.mjs",
    "sql:check": "node scripts/sql-bundles.mjs --check",
