{
  "name": "studyhub",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/access.test.mjs && node tests/database.test.mjs && node --import tsx --test tests/interface.test.tsx",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:preview": "npm run build && node scripts/make-preview.mjs",
    "test:reader:browser": "node tests/reader.browser.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright-core": "1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
