    "test:teacher:browser": "node tests/teacher.browser.mjs",
    "test:pdf:optimize:browser": "node tests/pdf-optimize.browser.mjs",
    "test:material:intake:browser": "node tests/material-intake.browser.mjs",
    "test:ai:edge": "deno test --allow-env supabase/functions/material-analyze/handler.test.ts",
